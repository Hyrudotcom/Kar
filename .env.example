# Copy to .env.local. Local values come from `npx supabase status` after `npm run db:start`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google native sign-in client ids (Supabase auth.external.google)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Device builds only: 1 = in-memory demo data instead of Supabase (never in release builds)
EXPO_PUBLIC_DEMO_MODE=
# Node-only (tests): direct Postgres connection of the local stack
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
